# TraceRAG configuration template.
# Copy to .env and edit. Never commit a real .env - it is gitignored.
#
# TraceRAG runs fully without any of these set: it defaults to extractive
# answers over keyword + semantic + hybrid retrieval, with no API key.

# --- Optional LLM mode -------------------------------------------------
# Set all three to enable LLM answer mode. Any OpenAI-compatible
# chat-completions endpoint works. These are read server-side only and are
# never sent to the browser or written to logs.
#
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini
#
# A local provider works the same way, and costs nothing:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# --- Retrieval ---------------------------------------------------------
# Changing chunking or the model moves the corpus fingerprint and forces the
# index to rebuild on next start.
# CHUNK_SIZE=900
# CHUNK_OVERLAP=180
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RRF_K=60
# DEFAULT_TOP_K=5

# --- Abstention --------------------------------------------------------
# Fraction of the question's content terms that must appear in the retrieved
# evidence before TraceRAG will answer. 0.55 was calibrated on the development
# split only; see docs/design-decisions.md.
# ABSTAIN_COVERAGE_THRESHOLD=0.55
# ABSTAIN_EVIDENCE_CHUNKS=5

# --- Uploads -----------------------------------------------------------
# MAX_UPLOAD_BYTES=1048576
